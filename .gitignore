# NOTE: this file must stay UTF-8. It was previously saved as UTF-16, which
# git cannot parse, so every rule below was silently inactive - .env,
# alsaab_ai.db and the .pyc files were all being tracked.

.env
.env.*
!.env.example

__pycache__/
*.pyc

*.db
*.sqlite
*.sqlite3

# Customer-uploaded product images live on the server disk, not in git.
backend/client_data/media/

# Scraped addresses. Never commit.
backend/found_emails.json
